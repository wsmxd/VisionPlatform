<UserControl x:Class="VisionPlatform.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:VisionPlatform.Infrastructure">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左: 配方列表 ============ -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="配方列表" FontWeight="SemiBold" Margin="2,0,0,8" />

                <ListBox Grid.Row="1" ItemsSource="{Binding Recipes}"
                         SelectedItem="{Binding SelectedRecipe}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBgHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2B4A6E" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock DockPanel.Dock="Right" FontSize="11"
                                               Foreground="{StaticResource AccentBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        使用中
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding Description}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                    <Button Content="新建" Style="{StaticResource BtnGhost}" Command="{Binding NewRecipeCommand}" />
                    <Button Content="复制" Style="{StaticResource BtnGhost}" Command="{Binding CloneRecipeCommand}" Margin="6,0,0,0" />
                    <Button Content="删除" Style="{StaticResource BtnGhost}" Command="{Binding DeleteRecipeCommand}" Margin="6,0,0,0" />
                    <Button Content="保存" Style="{StaticResource BtnPrimary}" Command="{Binding SaveRecipeCommand}" Margin="6,0,0,0" />
                    <Button Content="应用为当前" Style="{StaticResource BtnSuccess}" Command="{Binding ApplyRecipeCommand}" Margin="6,0,0,0" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============ 右: 配方编辑 ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="配方名称" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentRecipe.Name}" Margin="0,0,20,8" />
                        <TextBlock Text="描述" Grid.Row="0" Grid.Column="2" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,8" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding CurrentRecipe.Description}" Margin="0,0,0,8" />
                    </Grid>
                </Border>

                <!-- 相机参数 -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="相机参数" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="曝光" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.Exposure}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="增益" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.Gain}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0">
                                <TextBlock Text="宽度 (0=默认)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.FrameWidth}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="高度 (0=默认)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.FrameHeight}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 检测区域 ROI -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="检测区域 ROI" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right" Text="仅在区域内执行检测，可避开定位孔/边缘等固定结构" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="X" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.RoiX}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="Y" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.RoiY}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0">
                                <TextBlock Text="宽度 (0=全图)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.RoiW}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                <TextBlock Text="高度 (0=全图)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.RoiH}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="提示: 修改后在「实时检测」页按 打开相机 查看 ROI 虚线框位置" FontSize="11" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 斑点检测 -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding CurrentRecipe.UseBlob}">
                                <TextBlock Text="斑点检测 (脏污 / 异物 / 缺损)" FontWeight="SemiBold" />
                            </CheckBox>
                            <TextBlock DockPanel.Dock="Right" Text="二值化 + 连通域分析" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="灰度阈值 (0-255)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.BlobThreshold}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="最小面积 (px²)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.BlobMinArea}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="最大面积 (px²)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.BlobMaxArea}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 划痕检测 -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding CurrentRecipe.UseScratch}">
                                <TextBlock Text="划痕检测 (线状缺陷)" FontWeight="SemiBold" />
                            </CheckBox>
                            <TextBlock DockPanel.Dock="Right" Text="Canny + Hough 直线拟合" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="边缘阈值 (Canny上限)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.ScratchThreshold}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="最小长度 (px)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.ScratchMinLength}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="允许最大条数" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.ScratchMaxCount}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 模板匹配 -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding CurrentRecipe.UseTemplate}">
                                <TextBlock Text="模板匹配 (缺件 / 错位 / 漏加工)" FontWeight="SemiBold" />
                            </CheckBox>
                            <TextBlock DockPanel.Dock="Right" Text="归一化互相关 TM_CCOEFF_NORMED" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="模板图像路径" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.TemplatePath}" Margin="0,4,0,0" IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="最低相似度" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.TemplateThreshold}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="提示: 在「实时检测」页打开相机后点击「截取模板」，以良品图像生成模板" FontSize="11" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 亮度检测 -->
                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding CurrentRecipe.UseBrightness}">
                                <TextBlock Text="亮度检测 (过暗 / 过亮 / 光照异常)" FontWeight="SemiBold" />
                            </CheckBox>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="平均灰度下限" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.BrightnessMin}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="平均灰度上限" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding CurrentRecipe.BrightnessMax}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
