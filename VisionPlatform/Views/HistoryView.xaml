<UserControl x:Class="VisionPlatform.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:VisionPlatform.Infrastructure">
    <UserControl.Resources>
        <infra:BoolToOkNgBrushConverter x:Key="OkNgBrush" />
        <infra:BoolToTextConverter x:Key="OkNgText" />
        <infra:DoubleToPercentConverter x:Key="Percent" />
        <infra:MillisecondConverter x:Key="Ms" />
        <infra:DefectsSummaryConverter x:Key="DefectsSummary" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <!-- ============ 查询条件 + 统计 ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="开始日期" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <DatePicker SelectedDate="{Binding FromDate}" Margin="0,4,0,0"
                                Background="{StaticResource InputBgBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="结束日期" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <DatePicker SelectedDate="{Binding ToDate}" Margin="0,4,0,0"
                                Background="{StaticResource InputBgBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0">
                    <TextBlock Text="产品" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="10,0" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <CheckBox IsChecked="{Binding ShowOk}" Content="OK" Foreground="{StaticResource OkBrush}" Margin="0,0,14,0" />
                    <CheckBox IsChecked="{Binding ShowNg}" Content="NG" Foreground="{StaticResource NgBrush}" />
                </StackPanel>
                <Button Grid.Column="4" Content="查询" Style="{StaticResource BtnPrimary}" Command="{Binding QueryCommand}"
                        Margin="10,0,0,0" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <!-- ============ 结果表格 ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="查询结果" FontWeight="SemiBold" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="导出 CSV" Style="{StaticResource BtnGhost}" Command="{Binding ExportCsvCommand}" />
                        <Button Content="导出 HTML 报表" Style="{StaticResource BtnGhost}" Command="{Binding ExportHtmlCommand}" Margin="6,0,0,0" />
                        <Button Content="清理30天前" Style="{StaticResource BtnGhost}" Command="{Binding PruneOldCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="统计: " Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="10,0">
                        <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" />
                        <TextBlock Text=" 总数" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="2" Margin="20,0">
                        <TextBlock Text="{Binding OkCount}" FontWeight="Bold" Foreground="{StaticResource OkBrush}" />
                        <TextBlock Text=" OK" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="3" Margin="20,0">
                        <TextBlock Text="{Binding NgCount}" FontWeight="Bold" Foreground="{StaticResource NgBrush}" />
                        <TextBlock Text=" NG" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="4" Margin="20,0">
                        <TextBlock Text="{Binding YieldPercent, Converter={StaticResource Percent}}" FontWeight="Bold" />
                        <TextBlock Text=" 良品率" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                          BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                          Background="Transparent" FontSize="12"
                          MouseDoubleClick="OnRowDoubleClick">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOk}" Value="False">
                                    <Setter Property="Background" Value="#3A2A2B" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="#2B4A6E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}" Width="160" />
                        <DataGridTextColumn Header="产品" Binding="{Binding ProductName}" Width="110" />
                        <DataGridTextColumn Header="序列号" Binding="{Binding SerialNumber}" Width="180" />
                        <DataGridTextColumn Header="配方" Binding="{Binding RecipeName}" Width="110" />
                        <DataGridTemplateColumn Header="结果" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IsOk, Converter={StaticResource OkNgText}, ConverterParameter=OK|NG}"
                                               FontWeight="Bold"
                                               Foreground="{Binding IsOk, Converter={StaticResource OkNgBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="耗时(ms)" Binding="{Binding ElapsedMs, Converter={StaticResource Ms}}" Width="90" />
                        <DataGridTextColumn Header="缺陷" Binding="{Binding Defects, Converter={StaticResource DefectsSummary}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ============ NG 图像回看 ============ -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="NG 图像回看 (双击结果行)" FontWeight="SemiBold" Margin="0,0,0,8" />

                <Grid Grid.Row="1">
                    <Border x:Name="ImagePlaceholder" Background="#0D0F13" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="双击 NG 记录查看存档图像" Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image x:Name="NgImage" Stretch="Uniform" Visibility="Collapsed" />
                </Grid>

                <StackPanel Grid.Column="1" Grid.Row="1" Width="260" Margin="12,0,0,0">
                    <TextBlock Text="缺陷明细" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DefectListPanel" />
                    </ScrollViewer>
                    <TextBlock x:Name="HistoryStatusText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
