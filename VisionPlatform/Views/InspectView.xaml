<UserControl x:Class="VisionPlatform.Views.InspectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:VisionPlatform.Controls"
             xmlns:infra="clr-namespace:VisionPlatform.Infrastructure"
             xmlns:models="clr-namespace:VisionPlatform.Models"
             mc:Ignorable="d">
    <UserControl.Resources>
        <infra:BoolToOkNgBrushConverter x:Key="OkNgBrush" />
        <infra:BoolToTextConverter x:Key="OkNgText" />
        <infra:DoubleToPercentConverter x:Key="Percent" />
        <infra:MillisecondConverter x:Key="Ms" />
        <infra:EnumToDescriptionConverter x:Key="EnumDesc" />
        <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:FractionToPercentValueConverter x:Key="Percent2Value" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧: 图像 + 结果列表 ============ -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="190" />
            </Grid.RowDefinitions>

            <!-- 运行状态栏 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding RunStatus}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="  配方: " Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding Recipe.Name}" />
                        <TextBlock Text="  检测耗时: " Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding LastElapsedMs, Converter={StaticResource Ms}}" />
                        <TextBlock Text="  采集帧率: " Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0" />
                        <TextBlock Text="{Binding Fps}" />
                        <TextBlock Text=" fps" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="手动触发" Style="{StaticResource BtnPrimary}" Command="{Binding ManualTriggerCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="开始检测" Style="{StaticResource BtnSuccess}" Command="{Binding StartCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <Button Content="停止" Style="{StaticResource BtnDanger}" Command="{Binding StopCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 图像显示 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <ctrl:ImageDisplayControl x:Name="ImageDisplay" />
            </Border>

            <!-- 最近结果 -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="10,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="最近检测结果" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentResults}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False"
                              BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                              Background="Transparent" RowHeight="28" FontSize="12">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOk}" Value="False">
                                        <Setter Property="Background" Value="#3A2A2B" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#2B4A6E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time, StringFormat=HH:mm:ss.fff}" Width="85" />
                            <DataGridTextColumn Header="序列号" Binding="{Binding Serial}" Width="160" />
                            <DataGridTemplateColumn Header="结果" Width="52">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsOk, Converter={StaticResource OkNgText}, ConverterParameter=OK|NG}"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding IsOk, Converter={StaticResource OkNgBrush}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="耗时" Binding="{Binding ElapsedMs, Converter={StaticResource Ms}}" Width="70" />
                            <DataGridTextColumn Header="缺陷" Binding="{Binding DefectSummary}" Width="*" />
                            <DataGridTextColumn Header="说明" Binding="{Binding SimDefectInfo}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 右侧: 控制面板 ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,10,10,10">
            <StackPanel>

                <!-- 检测控制 -->
                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="检测控制" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="触发方式" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding TriggerModes}"
                                  SelectedItem="{Binding TriggerMode}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDesc}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="触发间隔 (ms)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,0" />
                        <TextBox Text="{Binding IntervalMs}" Margin="0,4,0,0" />
                        <TextBlock Text="模拟相机将按此间隔持续生成工件图像" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 相机 -->
                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="相机设置" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="相机源" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Cameras}"
                                      SelectedItem="{Binding SelectedCamera}" />
                            <Button Grid.Column="1" Content="扫描" Style="{StaticResource BtnGhost}"
                                    Command="{Binding ScanCamerasCommand}" Margin="6,0,0,0" Padding="10,5" />
                        </Grid>
                        <Button Content="选择视频文件..." Style="{StaticResource BtnGhost}"
                                Command="{Binding BrowseVideoFileCommand}" Margin="0,6,0,0" Padding="10,5" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="曝光" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Recipe.Exposure}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="增益" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <TextBox Text="{Binding Recipe.Gain}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="打开相机" Style="{StaticResource BtnPrimary}" Command="{Binding OpenCameraCommand}"
                                    Visibility="{Binding IsCameraOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <Button Content="关闭相机" Style="{StaticResource BtnGhost}" Command="{Binding CloseCameraCommand}"
                                    Visibility="{Binding IsCameraOpen, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="截取模板" Style="{StaticResource BtnGhost}" Command="{Binding SaveTemplateCommand}"
                                    Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding CameraStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 实时统计 -->
                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="实时统计" FontWeight="SemiBold" />
                            <Button Content="清零" Style="{StaticResource BtnGhost}" DockPanel.Dock="Right" FontSize="11"
                                    Padding="8,2" Command="{Binding ClearSessionStatsCommand}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SessionTotal}" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="总数" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding SessionOk}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource OkBrush}" />
                                <TextBlock Text="良品" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding SessionNg}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource NgBrush}" />
                                <TextBlock Text="不良" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="良品率" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                            <ProgressBar Grid.Column="1" Height="8" Margin="10,0,0,0"
                                         Maximum="100" Value="{Binding SessionYield, Converter={StaticResource Percent2Value}}" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Right">
                            <TextBlock.Text>
                                <Binding Path="SessionYield" StringFormat="P1" />
                            </TextBlock.Text>
                        </TextBlock>

                        <!-- 24小时直方图 -->
                        <TextBlock Text="今日检测趋势 (每小时)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,4" />
                        <ctrl:HourlyBarChart Height="70" Counts="{Binding HourlyCounts}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
