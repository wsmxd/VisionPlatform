<UserControl x:Class="VisionPlatform.Views.PlcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:VisionPlatform.Infrastructure">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:BoolToTextConverter x:Key="BoolText" />
        <infra:StatusToBrushConverter x:Key="StatusToBrush" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左: 连接 + 模拟器 ============ -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">

            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="PLC 连接" FontWeight="SemiBold" />
                        <Ellipse Width="10" Height="10" DockPanel.Dock="Right">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Host}" Margin="0,0,6,0" ToolTip="IP 地址" />
                        <TextBox Grid.Column="1" Text="{Binding Port}" Margin="0,0,6,0" ToolTip="端口" />
                        <TextBox Grid.Column="2" Text="{Binding UnitId}" ToolTip="单元号" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="连接" Style="{StaticResource BtnPrimary}" Command="{Binding ConnectCommand}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <Button Content="断开" Style="{StaticResource BtnDanger}" Command="{Binding DisconnectCommand}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionInfo}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" />
                    <TextBlock Text="协议: 手写 Modbus TCP 主站 (FC01/02/03/04/05/06/10)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="内置 PLC 模拟器" FontWeight="SemiBold" />
                        <Ellipse Width="10" Height="10" DockPanel.Dock="Right">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SimulatorRunning}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </DockPanel>

                    <TextBlock Text="无 PLC 硬件时启动模拟器，即可完整体验联机触发流程" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="启动模拟器" Style="{StaticResource BtnSuccess}" Command="{Binding StartSimulatorCommand}"
                                Visibility="{Binding SimulatorRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        <Button Content="停止模拟器" Style="{StaticResource BtnDanger}" Command="{Binding StopSimulatorCommand}"
                                Visibility="{Binding SimulatorRunning, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding SimulatorAutoTrigger}" Content="自动发出触发信号" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="触发间隔 (ms)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBox Text="{Binding SimulatorIntervalMs}" Width="90" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="14">
                <StackPanel>
                    <TextBlock Text="信号地址映射" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="触发线圈 (读)" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,6,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TriggerCoilAddr}" Margin="0,0,10,6" />
                        <TextBlock Text="OK 线圈 (写)" Grid.Row="0" Grid.Column="2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,6,6" />
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding OkCoilAddr}" Margin="0,0,0,6" />
                        <TextBlock Text="NG 线圈 (写)" Grid.Row="1" Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NgCoilAddr}" Margin="0,0,10,6" />
                        <TextBlock Text="总计数寄存器" Grid.Row="1" Grid.Column="2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding TotalCountRegAddr}" Margin="0,0,0,6" />
                        <TextBlock Text="NG计数寄存器" Grid.Row="2" Grid.Column="2" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,6,0" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding NgCountRegAddr}" Margin="0,0,0,0" />
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="4" Text="地址为 0 基物理地址。32位计数占用连续2个寄存器(高16位在前)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ============ 右: IO 测试 ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="IO 测试" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="读写测试按钮（需先连接 PLC）" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="读触发线圈" Style="{StaticResource BtnGhost}" Command="{Binding TestTriggerCoilCommand}" />
                                <Button Content="写 OK 线圈" Style="{StaticResource BtnGhost}" Command="{Binding TestWriteOkNgCommand}" Margin="6,0,0,0" />
                                <Button Content="读计数寄存器" Style="{StaticResource BtnGhost}" Command="{Binding TestReadRegistersCommand}" Margin="6,0,0,0" />
                                <Button Content="发送触发脉冲" Style="{StaticResource BtnPrimary}" Command="{Binding TestPulseTriggerCommand}" Margin="6,0,0,0" />
                            </WrapPanel>
                            <Border Background="{StaticResource InputBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0" MinHeight="80">
                                <TextBlock Text="{Binding TestResult}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                            </Border>
                            <TextBlock Margin="0,14,0,0">
                                <Run Text="联机流程说明:" FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="1. 启动模拟器 (或连接真实 PLC)" FontSize="12" />
                                <LineBreak />
                                <Run Text="2. 在「实时检测」页选择触发方式 = PLC 触发，开始检测" FontSize="12" />
                                <LineBreak />
                                <Run Text="3. 模拟器周期性置位触发线圈，流水线收到上升沿即采集检测" FontSize="12" />
                                <LineBreak />
                                <Run Text="4. 检测完成后写 OK/NG 线圈并累加计数寄存器" FontSize="12" />
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 模拟器寄存器监视 -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="模拟器状态: " Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding SimulatorRunning, Converter={StaticResource BoolText}, ConverterParameter=运行中|已停止}"
                                   Foreground="{Binding SimulatorRunning, Converter={StaticResource StatusToBrush}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="检测提示: 连接「127.0.0.1:502」后点击「读计数寄存器」查看流水线写入的数据" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
